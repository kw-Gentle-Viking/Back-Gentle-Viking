# Runtime
APP_ENV=production
DEMO_MODE=false
DEMO_AUTOTRADE_LOOP=false
CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN

# Docker Compose service names are used as hosts inside GCP VM containers.
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
MARKET_DB_PASSWORD=CHANGE_ME_MARKET_DB_PASSWORD
DATABASE_URL=postgresql://trader:CHANGE_ME_APP_DB_PASSWORD@app-db:5432/trading
MARKET_DB_URL=postgresql://trader:CHANGE_ME_MARKET_DB_PASSWORD@market-db:5432/market_data
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123

# Auth
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_BACKEND_DOMAIN/auth/google/callback

# KIS
KIS_MOCK=true
KIS_REAL_TRADING_ENABLED=false
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACC_NO=

# AI/report integrations
AI_SERVER_API_KEY=CHANGE_ME_SHARED_AI_KEY
AI_ALLOW_DUMMY_PREDICTIONS=false
GEMINI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DART_API_KEY=
